# MongoDB connection (must point to the SAME database the POS backend uses)
MONGODB_URI=mongodb://localhost:27017/pos-db

# Port this ML service listens on
ML_PORT=8100

# Comma-separated CORS origins allowed to call this service directly (optional).
# In normal operation the Node backend proxies requests, so this can stay narrow.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Where trained model artifacts are stored
MODEL_DIR=app/models
